[
  {
    "type": "text",
    "label": "\u21c4 Pane",
    "margin": "20px 0 20px 0",
    "size": "20px"
  },
  {
    "type": "separator",
    "label": "Open Pane",
    "id": "mod.pane.section-0"
  },
  {
    "property": "mod.pane.toolbar-visibility",
    "label": "Toolbar visibility",
    "type": "dropdown",
    "value": "number",
    "defaultValue": 0,
    "options": [
      {
        "label": "Auto-hide",
        "value": 0
      },
      {
        "label": "Always visible",
        "value": 1
      }
    ]
  },
  {
    "property": "mod.pane.shortcut",
    "label": "Keyboard shortcut",
    "type": "dropdown",
    "value": "number",
    "defaultValue": 0,
    "placeholder": false,
    "options": [
      {
        "label": "Recommended for this computer",
        "value": 0
      },
      {
        "label": "Alt + Shift + P",
        "value": 1
      },
      {
        "label": "Disabled",
        "value": 2
      },
      {
        "label": "Custom",
        "value": 3
      }
    ]
  },
  {
    "property": "mod.pane.custom-shortcut",
    "label": "Custom picker shortcut",
    "type": "string",
    "defaultValue": "Alt+Shift+P",
    "conditions": {
      "if": {
        "property": "mod.pane.shortcut",
        "value": 3
      }
    }
  },
  {
    "type": "text",
    "label": "Click Change shortcut and press your preferred keys.",
    "size": "12px"
  },
  {
    "property": "mod.pane.pane-button",
    "label": "Show the \u21c4 button on each split pane",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.pane.diagnostics-shortcut",
    "label": "Enable the diagnostic report shortcut",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.pane.diagnostics-keybinding",
    "label": "Diagnostic report shortcut",
    "type": "string",
    "defaultValue": "Auto",
    "conditions": {
      "if": {
        "property": "mod.pane.diagnostics-shortcut",
        "value": true
      }
    }
  },
  {
    "type": "text",
    "label": "Auto uses the recommended shortcut for this computer.",
    "size": "12px"
  },
  {
    "type": "separator",
    "label": "Accordion",
    "id": "mod.pane.section-1"
  },
  {
    "property": "mod.pane.layout-menu",
    "label": "Open split layout menu",
    "type": "string",
    "defaultValue": "Auto"
  },
  {
    "property": "mod.pane.accordion-previous",
    "label": "Previous tab in layout",
    "type": "string",
    "defaultValue": "Auto"
  },
  {
    "property": "mod.pane.accordion-next",
    "label": "Next tab in layout",
    "type": "string",
    "defaultValue": "Auto"
  },
  {
    "property": "mod.pane.accordion-widen",
    "label": "Widen expanded accordion tab",
    "type": "string",
    "defaultValue": "Auto"
  },
  {
    "property": "mod.pane.accordion-narrow",
    "label": "Narrow expanded accordion tab",
    "type": "string",
    "defaultValue": "Auto"
  },
  {
    "type": "text",
    "label": "These shortcuts navigate layouts and resize the active accordion tab.",
    "size": "12px"
  },
  {
    "property": "mod.pane.accordion-border-width",
    "label": "Accordion edge thickness",
    "type": "dropdown",
    "value": "number",
    "defaultValue": 0,
    "placeholder": false,
    "options": [
      {
        "label": "Off",
        "value": 0
      },
      {
        "label": "1 px",
        "value": 1
      },
      {
        "label": "2 px",
        "value": 2
      },
      {
        "label": "3 px",
        "value": 3
      },
      {
        "label": "4 px",
        "value": 4
      },
      {
        "label": "5 px",
        "value": 5
      },
      {
        "label": "6 px",
        "value": 6
      },
      {
        "label": "7 px",
        "value": 7
      },
      {
        "label": "8 px",
        "value": 8
      }
    ]
  },
  {
    "property": "mod.pane.accordion-border-color",
    "label": "Accordion edge color",
    "type": "string",
    "defaultValue": "rgba(255, 255, 255, 1)",
    "conditions": {
      "not": {
        "property": "mod.pane.accordion-border-width",
        "value": 0
      }
    }
  },
  {
    "property": "mod.pane.accordion-active-border-width",
    "label": "Active accordion tab border",
    "type": "dropdown",
    "value": "number",
    "defaultValue": 0,
    "options": [
      {
        "label": "Off",
        "value": 0
      },
      {
        "label": "1 px",
        "value": 1
      },
      {
        "label": "2 px",
        "value": 2
      },
      {
        "label": "3 px",
        "value": 3
      }
    ]
  },
  {
    "property": "mod.pane.accordion-active-border-color",
    "label": "Active accordion border color",
    "type": "string",
    "defaultValue": "rgba(255, 255, 255, 1)",
    "conditions": {
      "not": {
        "property": "mod.pane.accordion-active-border-width",
        "value": 0
      }
    }
  },
  {
    "id": "mod.pane.section-scrolling",
    "type": "separator",
    "label": "Scrolling"
  },
  {
    "property": "mod.pane.scrolling-modifier",
    "type": "dropdown",
    "value": "number",
    "defaultValue": 0,
    "label": "Hold while scrolling",
    "options": [
      {
        "label": "Option / Alt + Shift",
        "value": 0
      },
      {
        "label": "Option / Alt",
        "value": 1
      },
      {
        "label": "Disabled",
        "value": 2
      },
      {
        "label": "Custom",
        "value": 3
      }
    ]
  },
  {
    "property": "mod.pane.scrolling-width",
    "type": "dropdown",
    "value": "number",
    "defaultValue": 65,
    "label": "Scrolling tab width",
    "options": [
      {
        "label": "Half the view",
        "value": 50
      },
      {
        "label": "Two thirds",
        "value": 65
      },
      {
        "label": "Full view",
        "value": 100
      }
    ]
  },
  {
    "type": "text",
    "size": "12px",
    "label": "Choose Scrolling in a split layout menu. Hold the modifier to reveal columns, then scroll with the wheel or two fingers. Release to open the centered tab at full width. Drag a column edge to resize; double-click to reset. The layout and column widths are saved with the split."
  },
